# Keycloak release downloaded from GitHub.
KEYCLOAK_VERSION=26.7.0

# Existing PostgreSQL database settings must match the Keycloak 20 setup.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-this-database-password

# Used only to bootstrap an administrator when no administrator exists.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
