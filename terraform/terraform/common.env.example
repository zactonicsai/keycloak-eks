# ---------------------------------------------------------------------------
# common.env — the handful of values that YOU supply (everything else is
# generated from earlier stacks' outputs).  Copy to common.env and edit.
#
# Find these with:  ../scripts/00c-discover.sh
# ---------------------------------------------------------------------------
AWS_REGION="us-east-1"
NAME_PREFIX="keycloak"
CLUSTER_NAME="keycloak"
K8S_VERSION="1.31"

VPC_ID="vpc-REPLACE-ME"

# Two PRIVATE subnets in TWO DIFFERENT Availability Zones. Comma separated.
PRIVATE_SUBNET_IDS="subnet-REPLACE-ME-AZ-A,subnet-REPLACE-ME-AZ-B"

# Node cap
MAX_NODES="2"
VCPU_PER_NODE="2"

# Keycloak
KEYCLOAK_VERSION="26.6.1"
REPLICAS="1"

# Offline mode (leave false for a normal internet build)
OFFLINE_MODE="false"
ARTIFACTORY_HOST="artifactory.mycompany.com"
ARTIFACTORY_DOCKER_REPO="docker-local"
ARTIFACTORY_HELM_REPO="helm-local"
ARTIFACTORY_USERNAME="deploy-user"
