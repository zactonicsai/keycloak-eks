# ---------------------------------------------------------------------------
# backend.tf.example — OPTIONAL. Copy into EACH stack directory (with a unique
# "key") if more than one person will run these, or if you want state kept off
# your laptop.
#
# Why the key differs per stack: each stack owns its own state file. That
# separation is what lets you destroy and rebuild the cluster without touching
# the database, and lets two people work on different stacks at once.
#
# Create the bucket + lock table once:
#   aws s3api create-bucket --bucket my-tfstate-bucket --region us-east-1
#   aws s3api put-bucket-versioning --bucket my-tfstate-bucket \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name terraform-locks \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST
# ---------------------------------------------------------------------------
terraform {
  backend "s3" {
    bucket         = "my-tfstate-bucket"
    key            = "keycloak/01-rds/terraform.tfstate" # <-- change per stack
    region         = "us-east-1"
    dynamodb_table = "terraform-locks"
    encrypt        = true
  }
}
